FROM oven/bun:1 AS deps
WORKDIR /app

# Copy manifest files
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml* bun.lockb* ./
COPY packages ./packages
COPY apps ./apps

# Bun handles pnpm workspaces natively and much faster
RUN bun install

FROM deps AS builder
WORKDIR /app
# Build the server app
RUN cd apps/server && bun run build

FROM oven/bun:1-slim AS runner
WORKDIR /app
ENV NODE_ENV=production

# Copy all workspace files (needed for migration scripts to find their deps)
COPY --from=deps /app /app
# Copy the compiled production build
COPY --from=builder /app/apps/server/dist ./apps/server/dist
COPY docker/server/start.sh ./docker/server/start.sh

# MarkItDown is Python-only. Install it into a local venv used by the Bun wrapper.
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 python3-venv \
  && rm -rf /var/lib/apt/lists/* \
  && python3 -m venv /app/apps/server/.venv \
  && /app/apps/server/.venv/bin/pip install --no-cache-dir -r /app/apps/server/requirements.txt

RUN chmod +x ./docker/server/start.sh

EXPOSE 3000

# Ensure the database URL is available at runtime
CMD ["/app/docker/server/start.sh"]
