---
import Layout from "../layouts/Layout.astro";
import GridSeparator from "@/components/GridSeparator.astro";
import SetupSection from "@/components/SetupSection.astro";
import CtaSection from "@/components/CtaSection.astro";
import Header from "@/components/Header.astro";
import FeatureOverview from "@/components/FeatureOverview.astro";
import ScrollAnimation from "@/components/ScrollAnimation.astro";
import SalesText from "@/components/SalesText.astro";
import Integrations from "@/components/Integrations.astro";
import { PricingOptions } from "@/components/PricingOptions.tsx";
import FAQs from "@/components/Faqs";
import { FooterSection } from "@/components/Footer";
import EscalationCTA from "@/components/EscalationCTA.astro";
---

<Layout>
  <Header />
  <CtaSection />
    <FeatureOverview />
    <ScrollAnimation />
    <SetupSection />
    <GridSeparator />
    <SalesText />
    <GridSeparator />
    <Integrations />
    <GridSeparator />
    <EscalationCTA />
    <GridSeparator />
    <PricingOptions client:load />
    <GridSeparator />
    <FAQs client:load />
    <GridSeparator />
    <FooterSection client:load />
</Layout>
