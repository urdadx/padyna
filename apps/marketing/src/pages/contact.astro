---
import Layout from "@/layouts/Layout.astro";
---

<Layout>
  <div class="min-h-screen bg-white px-4 py-16">
    <div class="mx-auto max-w-3xl">
      <div class="mb-8 flex items-center gap-2">
        <a
          href="/"
          class="flex items-center gap-2 text-indigo-600 hover:underline"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-4 w-4"
          >
            <path d="M19 12H5"></path>
            <path d="M12 19l-7-7 7-7"></path>
          </svg>
          Go Back
        </a>
      </div>
      <div class="mx-auto mb-8 flex max-w-2xl items-center gap-3">
        <h1 class="text-center font-sans text-3xl font-bold text-gray-900">
          Contact Padyna
        </h1>
      </div>
      <div class="prose prose-indigo mx-auto max-w-2xl">
        <section class="mb-8">
          <h2 class="mb-4 text-xl font-semibold text-gray-900">Support</h2>
          <p class="mb-4 leading-relaxed text-gray-600">
            For help with your account, your AI agent, billing, or anything else
            about the service, email <a
              href="mailto:support@padyna.com"
              class="text-indigo-600 hover:underline">support@padyna.com</a
            >. Include the email address on your Padyna account and, if it is
            about a specific agent or conversation, what you were doing when the
            problem happened, so we can look into it quickly.
          </p>
        </section>
        <section class="mb-8">
          <h2 class="mb-4 text-xl font-semibold text-gray-900">
            Sales and demos
          </h2>
          <p class="mb-4 leading-relaxed text-gray-600">
            Want to see Padyna on your own content before you start? <a
              href="https://cal.com/padyna/15min"
              class="text-indigo-600 hover:underline">Book a 15-minute demo</a
            > with the team, or <a
              href="https://app.padyna.com/register"
              class="text-indigo-600 hover:underline">start a free trial</a
            > and set up your first agent in minutes. Plans and prices are on the
            <a href="/#pricing" class="text-indigo-600 hover:underline"
              >pricing section</a
            >.
          </p>
        </section>
        <section class="mb-8">
          <h2 class="mb-4 text-xl font-semibold text-gray-900">Your account</h2>
          <p class="mb-4 leading-relaxed text-gray-600">
            Already a customer? <a
              href="https://app.padyna.com/login"
              class="text-indigo-600 hover:underline"
              >Log in to the Padyna dashboard</a
            > to manage your agents, data sources, team members, integrations, and
            billing.
          </p>
        </section>
        <section class="mb-8">
          <h2 class="mb-4 text-xl font-semibold text-gray-900">Elsewhere</h2>
          <p class="mb-4 leading-relaxed text-gray-600">
            Follow product updates from Padyna on <a
              href="https://x.com/trypadyna"
              class="text-indigo-600 hover:underline">X (@trypadyna)</a
            >. For how we handle personal data, read the <a
              href="/privacy"
              class="text-indigo-600 hover:underline">Privacy Policy</a
            >; the <a
              href="/terms-of-service"
              class="text-indigo-600 hover:underline">Terms of Service</a
            > cover your use of the service.
          </p>
        </section>
      </div>
    </div>
  </div>
</Layout>
