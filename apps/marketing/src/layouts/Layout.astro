---
import "../styles/global.css";

const pathname = Astro.url.pathname;
const isLegalPage = pathname === "/privacy" || pathname === "/terms-of-service";
const shouldLoadWidget = pathname !== "/widget" && !isLegalPage;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="generator" content={Astro.generator} />
    <title>Padyna - AI customer support for your business</title>
  </head>
  <body class="min-h-screen bg-white">
    <div
      class="mx-auto flex min-h-screen max-w-7xl flex-col items-center justify-center border-x border-stone-200 bg-white"
    >
      <slot />
    </div>
    {
      shouldLoadWidget && (
        <>
          <script>
            (function (w, d) {
              if (w.self !== w.top) return;
              if (w.location.pathname === "/widget") return;
              if (typeof w.Padyna !== "function") {
                var q = [];
                var stub = function () {
                  q.push(arguments);
                };
                stub.q = q;
                w.Padyna = stub;
              }
              var s = d.createElement("script");
              s.src = "https://app.padyna.com/sdk.js";
              s.async = true;
              d.head.appendChild(s);
            })(window, document);
          </script>
          <script>
            if (
              window.self === window.top &&
              window.location.pathname !== "/widget"
            ) {
              window.Padyna("init", {
                widgetId: "padyna_UQXeODdWl2xDQ7Nm",
              });
            }
          </script>
        </>
      )
    }
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
