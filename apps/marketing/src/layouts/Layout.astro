---
import "../styles/global.css";

const pathname = Astro.url.pathname;
const isLegalPage = /^\/(privacy|terms-of-service)\/?$/.test(pathname);
const shouldLoadWidget = pathname !== "/widget" && !isLegalPage;
const title = "Padyna - Your customer support on autopilot";
const description =
  "Instantly answer customer queries with an AI support agent trained on your business";
const canonicalUrl = new URL(pathname, Astro.site ?? Astro.url);
const ogImageUrl = new URL("/og.png", Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body class="min-h-screen bg-white">
    <div
      class="mx-auto flex min-h-screen max-w-7xl flex-col items-center justify-center border-x border-stone-200 bg-white"
    >
      <slot />
    </div>
    {
      shouldLoadWidget && (
        <>
          <script>
            (function (w, d) {
              if (w.self !== w.top) return;
              if (w.location.pathname === "/widget") return;
              if (typeof w.Padyna !== "function") {
                var q = [];
                var stub = function () {
                  q.push(arguments);
                };
                stub.q = q;
                w.Padyna = stub;
              }
              var s = d.createElement("script");
              s.src = "https://app.padyna.com/sdk.js";
              s.async = true;
              d.head.appendChild(s);
            })(window, document);
          </script>
          <script>
            if (
              window.self === window.top &&
              window.location.pathname !== "/widget"
            ) {
              window.Padyna("init", {
                widgetId: "padyna_UQXeODdWl2xDQ7Nm",
              });
            }
          </script>
        </>
      )
    }
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
