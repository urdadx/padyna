---
import AISupportAnimation from "@/components/AISupportAnimation.astro";
import CardAnimation from "@/components/CardAnimation.astro";
import TrainingAnimation from "@/components/TrainingAnimation.astro";
---

<section class="flex flex-col items-center border-t bg-white">
  <div
    class="flex w-full max-w-2xl flex-col items-start gap-4 px-4 pt-16 pb-12 text-left sm:items-center sm:gap-2 sm:text-center"
  >
    <p
      class="text-primary font-mono text-sm font-medium tracking-[0.56px] uppercase sm:text-xs"
    >
      Super Fast Setup
    </p>
    <h2
      class="max-w-100.5 text-[24px] leading-[1.2] font-medium tracking-tight text-stone-900 sm:max-w-none sm:text-4xl sm:leading-tight"
    >
      Build the perfect customer-facing AI agent in minutes
    </h2>
    <p
      class="max-w-lg text-base leading-5.5 font-normal text-stone-500 sm:text-sm sm:leading-normal sm:text-stone-600"
    >
      Quick and simple setup, whether you're integrating or switching from
      another platform. Go from setup to handling support in minutes.
    </p>
  </div>
  <div
    class="flex w-full flex-col divide-y divide-stone-200 border-t border-stone-200 bg-stone-100 md:flex-row md:divide-x"
  >
    <CardAnimation />
    <TrainingAnimation />
    <AISupportAnimation />
  </div>
</section>
