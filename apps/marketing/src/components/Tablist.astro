---
import FeatureIcon from "./FeatureIcon.astro";
import playgroundPoster from "../assets/features/playground-poster.webp";
import actionsPoster from "../assets/features/actions-poster.webp";
import analyticsPoster from "../assets/features/analytics-poster.webp";
import activityPoster from "../assets/features/activity-poster.webp";

const features = [
  {
    id: "playground",
    label: "Playground",
    description: "Test and customize your AI agent effortlessly",
    alternative:
      "The Playground displays agent settings beside a live chat preview. Customize the agent name, icon, use case, brand color, welcome message, and suggested messages, then try a conversation in the preview.",
    video: "https://assets.padyna.com/assets/playground_long.mp4",
    poster: playgroundPoster,
  },
  {
    id: "actions",
    label: "Agent Actions",
    description: "Automate workflows directly inside the conversation.",
    alternative:
      "The Agent Actions screen lists workflows with descriptions, usage counts, and active status. Examples include booking meetings, creating Jira support tickets, and sending refund notifications from customer conversations.",
    video: "https://assets.padyna.com/assets/padyna_action.mp4",
    poster: actionsPoster,
  },
  {
    id: "analytics",
    label: "Analytics & Insights",
    description:
      "Track performance, uncover patterns, and understand every conversation.",
    alternative:
      "The Analytics dashboard shows visits, chats started, bounce rate, average session time, and live users for a selected date range. A timeline compares visits and chats, with breakdowns by platform, referrer, and data source below.",
    video: "https://assets.padyna.com/assets/padyna-analytics.mp4",
    poster: analyticsPoster,
  },
  {
    id: "activity",
    label: "Activity",
    description:
      "Track and manage your agent conversations with your customers.",
    alternative:
      "Activity shows a list of customer chats beside the selected conversation. Review customer messages, agent replies, and cited sources, filter recent chats, or use the conversation's Escalate and Close actions.",
    video: "https://assets.padyna.com/assets/padyna-activity.mp4",
    poster: activityPoster,
  },
] as const;
---

<feature-tabs class="block w-full border-t border-stone-200">
  <div
    class="feature-tablist"
    role="tablist"
    aria-label="Product features"
    hidden
  >
    {
      features.map(({ id, label }, index) => (
        <button
          type="button"
          role="tab"
          id={`feature-${id}-tab`}
          aria-controls={`feature-${id}-panel`}
          aria-selected={index === 0}
          tabindex={index === 0 ? 0 : -1}
          class="feature-tab relative flex flex-1 cursor-pointer items-center justify-center gap-2 border-r border-b border-stone-200 bg-stone-50 px-6 py-4 transition-colors duration-200 last:border-r-0 hover:bg-stone-100/50"
        >
          <FeatureIcon name={id} />
          <span class="hidden font-mono text-sm font-medium tracking-tight text-stone-600 uppercase transition-colors md:inline">
            {label}
          </span>
          <span class="font-mono text-sm font-medium tracking-tight text-stone-600 uppercase transition-colors md:hidden">
            {id === "actions"
              ? "Action"
              : id === "analytics"
                ? "Analytics"
                : label}
          </span>
        </button>
      ))
    }
  </div>

  {
    features.map(
      ({ id, label, description, alternative, video, poster }, index) => (
        <details class="feature-disclosure w-full" open={index === 0}>
          <summary
            id={`feature-${id}-summary`}
            class="cursor-pointer items-center justify-between border-b border-stone-200 bg-stone-50 px-6 py-4 text-left"
          >
            <span class="flex items-center gap-2">
              <FeatureIcon name={id} />
              <span class="font-mono text-sm font-medium tracking-tight text-stone-800 uppercase">
                {label}
              </span>
            </span>
            <svg
              class="feature-chevron"
              aria-hidden="true"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m6 9 6 6 6-6" />
            </svg>
          </summary>
          <div
            id={`feature-${id}-panel`}
            class="feature-panel overflow-hidden border-b border-stone-200 bg-white md:border-b-0"
          >
            <figure class="m-0 p-0 md:p-8">
              <div class="relative h-96 w-full overflow-hidden bg-stone-950 md:h-168">
                <video
                  id={`feature-${id}-video`}
                  data-src={video}
                  poster={poster.src}
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="none"
                  tabindex="-1"
                  aria-label={`${label} demo`}
                  aria-describedby={`feature-${id}-description feature-${id}-alternative`}
                  class="absolute inset-0 h-full w-full object-cover"
                />
                <div class="absolute inset-x-0 bottom-0 hidden p-6 md:block md:p-8">
                  <div class="w-fit rounded-lg border border-white/15 bg-black/35 px-4 py-3 text-white backdrop-blur-sm">
                    <p
                      id={`feature-${id}-description`}
                      class="mt-1 text-sm text-white/90"
                    >
                      {description}
                    </p>
                  </div>
                </div>
                <button
                  data-playback
                  data-label={label}
                  type="button"
                  aria-label={`Pause ${label} demo`}
                  aria-controls={`feature-${id}-video`}
                  class="feature-playback absolute top-3 right-3 flex size-11 cursor-pointer items-center justify-center rounded-lg border border-white/15 bg-black/35 text-white backdrop-blur-sm hover:bg-black/55"
                  hidden
                >
                  <svg
                    aria-hidden="true"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                  >
                    <path data-pause-icon d="M6 4h4v16H6zm8 0h4v16h-4z" />
                    <path data-play-icon d="m7 4 14 8-14 8z" />
                  </svg>
                </button>
              </div>
              <figcaption id={`feature-${id}-alternative`} class="sr-only">
                {alternative}
              </figcaption>
              <p data-video-status role="status" class="sr-only" />
            </figure>
          </div>
        </details>
      ),
    )
  }
</feature-tabs>

<script>
  class FeatureTabs extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      const controller = new AbortController();
      const { signal } = controller;
      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      );
      const tablist = this.querySelector<HTMLElement>('[role="tablist"]')!;
      const tabs = [
        ...this.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
      ];
      const disclosures = [
        ...this.querySelectorAll<HTMLDetailsElement>(".feature-disclosure"),
      ];
      const panels = [...this.querySelectorAll<HTMLElement>(".feature-panel")];
      const videos = [...this.querySelectorAll<HTMLVideoElement>("video")];
      const controls = [
        ...this.querySelectorAll<HTMLButtonElement>("[data-playback]"),
      ];
      const nearby = new Set<Element>();
      const visible = new Set<Element>();
      const userPaused = new Set<number>();
      const motionOptIn = new Set<number>();
      const pending = new Set<HTMLVideoElement>();
      let active = 0;
      let manuallyControlled = false;

      const stopCycling = () => {
        manuallyControlled = true;
        this.removeAttribute("data-cycling");
      };
      // CSS is the clock, so the border and tab advancement cannot drift apart.
      this.addEventListener(
        "animationend",
        (event) => {
          if (
            event.animationName !== "feature-countdown" ||
            !this.hasAttribute("data-cycling") ||
            document.hidden ||
            reducedMotion.matches ||
            manuallyControlled
          )
            return;
          active = (active + 1) % tabs.length;
          render();
        },
        { signal },
      );
      this.addEventListener("focusin", stopCycling, { signal });
      this.addEventListener("click", stopCycling, { signal });

      const wantsPlayback = (index: number) =>
        !userPaused.has(index) &&
        (!reducedMotion.matches || motionOptIn.has(index));

      const updateMedia = () => {
        if (signal.aborted) return;
        this.toggleAttribute(
          "data-cycling",
          !manuallyControlled &&
            !reducedMotion.matches &&
            !document.hidden &&
            disclosures[active].open &&
            visible.has(videos[active]) &&
            wantsPlayback(active),
        );
        videos.forEach((video, index) => {
          const enabled = wantsPlayback(index);
          const selected = disclosures[index].open && index === active;
          const shouldPlay =
            selected && enabled && visible.has(video) && !document.hidden;
          video.autoplay = shouldPlay;
          // Attach only the approaching, active panel's source. Reduced motion
          // keeps the real poster until the visitor explicitly opts into playback.
          if (
            selected &&
            enabled &&
            nearby.has(video) &&
            !document.hidden &&
            !video.hasAttribute("src")
          ) {
            video.src = video.dataset.src!;
          }
          if (!shouldPlay) video.pause();
          else if (
            video.hasAttribute("src") &&
            video.paused &&
            !pending.has(video)
          ) {
            pending.add(video);
            void video
              .play()
              .catch((error: DOMException) => {
                if (error.name !== "AbortError") {
                  userPaused.add(index);
                  updateMedia();
                }
              })
              .finally(() => {
                pending.delete(video);
                // A quick tab/viewport change can interrupt an in-flight play.
                if (video.autoplay && video.paused && !video.error)
                  updateMedia();
              });
          }
          controls[index].setAttribute(
            "aria-label",
            `${enabled ? "Pause" : "Play"} ${controls[index].dataset.label} demo`,
          );
          controls[index].toggleAttribute("data-paused", !enabled);
        });
      };

      const render = () => {
        tablist.hidden = false;
        this.setAttribute("data-tabs", "");
        disclosures.forEach((details, index) => {
          const selected = index === active;
          details.open = selected;
          tabs[index].setAttribute("aria-selected", String(selected));
          tabs[index].tabIndex = selected ? 0 : -1;
          panels[index].setAttribute("role", "tabpanel");
          panels[index].setAttribute("aria-labelledby", tabs[index].id);
          panels[index].tabIndex = 0;
        });
        // Scroll only the tab strip, never the page, when advancing a mobile tab.
        const strip = tablist.getBoundingClientRect();
        const selectedTab = tabs[active].getBoundingClientRect();
        if (selectedTab.left < strip.left)
          tablist.scrollLeft += selectedTab.left - strip.left;
        else if (selectedTab.right > strip.right)
          tablist.scrollLeft += selectedTab.right - strip.right;
        updateMedia();
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener(
          "click",
          () => {
            active = index;
            render();
          },
          { signal },
        );
        tab.addEventListener(
          "keydown",
          (event) => {
            let next = index;
            if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
            else if (event.key === "ArrowLeft")
              next = (index - 1 + tabs.length) % tabs.length;
            else if (event.key === "Home") next = 0;
            else if (event.key === "End") next = tabs.length - 1;
            else return;
            event.preventDefault();
            active = next;
            render();
            tabs[next].focus();
          },
          { signal },
        );
      });

      disclosures.forEach((details, index) => {
        details.addEventListener(
          "toggle",
          () => {
            updateMedia();
          },
          { signal },
        );
        const video = videos[index];
        const control = controls[index];
        video.muted = true;
        control.hidden = false;
        control.addEventListener(
          "click",
          () => {
            if (wantsPlayback(index)) {
              userPaused.add(index);
              motionOptIn.delete(index);
            } else {
              userPaused.delete(index);
              motionOptIn.add(index);
              if (video.error) video.load();
            }
            updateMedia();
          },
          { signal },
        );
        const status = details.querySelector<HTMLElement>(
          "[data-video-status]",
        )!;
        video.addEventListener(
          "error",
          () => {
            userPaused.add(index);
            status.textContent =
              "The demo is unavailable. A still image and text description are provided instead.";
            updateMedia();
          },
          { signal },
        );
        video.addEventListener(
          "playing",
          () => {
            status.textContent = "";
          },
          { signal },
        );
      });
      const observe = (
        entries: IntersectionObserverEntry[],
        targets: Set<Element>,
      ) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && entry.intersectionRatio > 0)
            targets.add(entry.target);
          else targets.delete(entry.target);
        });
        updateMedia();
      };
      const nearObserver = new IntersectionObserver(
        (entries) => observe(entries, nearby),
        { rootMargin: "320px 0px" },
      );
      const visibleObserver = new IntersectionObserver(
        (entries) => observe(entries, visible),
        { threshold: [0, 0.01] },
      );
      videos.forEach((video) => {
        nearObserver.observe(video);
        visibleObserver.observe(video);
      });
      document.addEventListener("visibilitychange", updateMedia, { signal });
      reducedMotion.addEventListener(
        "change",
        () => {
          motionOptIn.clear();
          updateMedia();
        },
        { signal },
      );
      render();
      this.cleanup = () => {
        controller.abort();
        nearObserver.disconnect();
        visibleObserver.disconnect();
      };
    }

    disconnectedCallback() {
      this.cleanup?.();
      this.querySelectorAll("video").forEach((video) => {
        video.autoplay = false;
        video.pause();
      });
    }
  }

  if (!customElements.get("feature-tabs"))
    customElements.define("feature-tabs", FeatureTabs);
</script>

<style>
  [hidden] {
    display: none !important;
  }
  summary {
    position: relative;
    display: flex;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  details[open] .feature-chevron {
    transform: rotate(180deg);
  }
  .feature-tablist:not([hidden]) {
    display: flex;
    overflow-x: auto;
    overscroll-behavior-x: contain;
  }
  .feature-tab {
    flex-shrink: 0;
    white-space: nowrap;
  }
  @media (width < 48rem) {
    .feature-tab {
      flex: 1 0 auto;
      padding-inline: 1rem;
    }
  }
  [data-tabs] summary {
    display: none;
  }
  .feature-tab[aria-selected="true"] {
    background: white;
    border-bottom-color: transparent;
  }
  .feature-tab[aria-selected="true"] > span {
    color: var(--color-stone-900);
  }
  .feature-tab[aria-selected="true"]::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 2px;
    background: var(--color-primary);
  }
  @keyframes feature-countdown {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-cycling] .feature-tab[aria-selected="true"]::after {
      content: "";
      position: absolute;
      inset: auto 0 0;
      height: 2px;
      background: var(--color-primary);
      transform-origin: left;
      animation: feature-countdown 10s linear forwards;
    }
  }
  button:focus-visible,
  summary:focus-visible,
  .feature-panel:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: -3px;
  }
  .feature-playback:focus-visible {
    outline-color: white;
  }
  .feature-playback:not([data-paused]) [data-play-icon],
  .feature-playback[data-paused] [data-pause-icon] {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .feature-chevron {
      transition: transform 0.3s ease-in-out;
    }
    @supports (interpolate-size: allow-keywords) {
      details::details-content {
        interpolate-size: allow-keywords;
        block-size: 0;
        overflow: clip;
        transition:
          block-size 0.4s cubic-bezier(0.04, 0.62, 0.23, 0.98),
          content-visibility 0.4s allow-discrete;
      }
      details[open]::details-content {
        block-size: auto;
      }
    }
  }
</style>
