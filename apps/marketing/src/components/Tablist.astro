---
import { Image } from "astro:assets";
import FeatureIcon from "./FeatureIcon.astro";
import PlaygroundDemo from "./PlaygroundDemo.astro";
import DemoBackdrop from "./DemoBackdrop.astro";
import actionsImage from "../assets/features/actions.webp";
import analyticsImage from "../assets/features/analytics.webp";
import livechatImage from "../assets/features/livechat.webp";

// `duration` is how long a tab stays selected while auto-cycling (seconds);
// the Playground demo gets long enough to finish one run of its conversation.
const features = [
  {
    id: "playground",
    label: "Assistant",
    alternative:
      "The Playground displays agent settings beside a live chat preview. A customer asks to change the delivery address on an order, and the agent asks for the new address and confirms the change.",
    demo: true,
    duration: 24,
  },
  {
    id: "livechat",
    label: "Live chat",
    alternative:
      "Chat logs list customer conversations from the website widget, WhatsApp, Slack, Telegram, and Discord beside the selected chat. The agent answers a duplicate-charge question, cites the sources it used, and the conversation can be escalated for live messaging or closed.",
    image: livechatImage,
    duration: 8,
  },
  {
    id: "analytics",
    label: "Analytics",
    alternative:
      "The Analytics dashboard shows visits, chats started, bounce rate, average session time, and live users for the last 30 days. A daily chart compares visits and chats, with top platforms and most referenced data sources below.",
    image: analyticsImage,
    duration: 8,
  },
  {
    id: "actions",
    label: "Agent Actions",
    alternative:
      "The Agent Actions screen lists workflows with descriptions, usage counts, and active status. Examples include booking product demos, creating Jira tickets, processing refunds, and notifying the team in Discord from customer conversations.",
    image: actionsImage,
    duration: 8,
  },
] as const;
---

<feature-tabs class="block w-full border-t border-stone-200">
  <div
    class="feature-tablist"
    role="tablist"
    aria-label="Product features"
    hidden
  >
    {
      features.map((feature, index) => (
        <button
          type="button"
          role="tab"
          id={`feature-${feature.id}-tab`}
          aria-controls={`feature-${feature.id}-panel`}
          aria-selected={index === 0}
          style={`--feature-duration: ${feature.duration}s`}
          tabindex={index === 0 ? 0 : -1}
          class="feature-tab relative flex flex-1 cursor-pointer items-center justify-center gap-2 border-r border-b border-stone-200 bg-stone-50 px-6 py-4 transition-colors duration-200 last:border-r-0 hover:bg-stone-100/50"
        >
          <FeatureIcon name={feature.id} />
          <span class="hidden font-mono text-sm font-medium tracking-tight text-stone-600 uppercase transition-colors md:inline">
            {feature.label}
          </span>
          <span class="font-mono text-xs font-medium tracking-tight text-stone-600 uppercase transition-colors md:hidden">
            {feature.id === "actions" ? "Actions" : feature.label}
          </span>
        </button>
      ))
    }
  </div>

  {
    features.map((feature, index) => {
      const { id, label, alternative } = feature;
      return (
        <details class="feature-disclosure w-full" open={index === 0}>
          <summary
            id={`feature-${id}-summary`}
            class="cursor-pointer items-center justify-between border-b border-stone-200 bg-stone-50 px-6 py-4 text-left"
          >
            <span class="flex items-center gap-2">
              <FeatureIcon name={id} />
              <span class="font-mono text-sm font-medium tracking-tight text-stone-800 uppercase">
                {label}
              </span>
            </span>
            <svg
              class="feature-chevron"
              aria-hidden="true"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m6 9 6 6 6-6" />
            </svg>
          </summary>
          <div
            id={`feature-${id}-panel`}
            class="feature-panel overflow-hidden border-b border-stone-200 bg-white md:border-b-0"
            aria-describedby={`feature-${id}-alternative`}
          >
            <figure class="relative m-0 p-3 sm:p-6 md:p-12 lg:p-16">
              <DemoBackdrop />
              <div class="relative aspect-video w-full overflow-hidden rounded-lg border border-black/5 bg-stone-50 shadow-[0_24px_60px_-20px_rgb(28_25_23/0.35)] md:rounded-xl">
                {"image" in feature ? (
                  <Image
                    src={feature.image}
                    alt=""
                    widths={[720, 1440, 2160, 2880]}
                    sizes="(min-width: 80rem) 1216px, (min-width: 48rem) calc(100vw - 4rem), 100vw"
                    loading={index === 0 ? "eager" : "lazy"}
                    class="absolute inset-0 h-full w-full object-cover object-top-left"
                  />
                ) : (
                  <PlaygroundDemo />
                )}
              </div>
              <figcaption id={`feature-${id}-alternative`} class="sr-only">
                {alternative}
              </figcaption>
            </figure>
          </div>
        </details>
      );
    })
  }
</feature-tabs>

<script>
  type DemoFrame = HTMLElement & {
    setPlaying?(playing: boolean): void;
  };

  class FeatureTabs extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      const controller = new AbortController();
      const { signal } = controller;
      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      );
      const tablist = this.querySelector<HTMLElement>('[role="tablist"]')!;
      const tabs = [
        ...this.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
      ];
      const disclosures = [
        ...this.querySelectorAll<HTMLDetailsElement>(".feature-disclosure"),
      ];
      const panels = [...this.querySelectorAll<HTMLElement>(".feature-panel")];
      const stages = panels.map(
        (panel) => panel.querySelector<HTMLElement>("figure > div")!,
      );
      // The Playground demo plays while selected and on screen; screenshots are static.
      const demos = panels.map((panel) =>
        panel.querySelector<DemoFrame>("demo-frame"),
      );
      const visible = new Set<Element>();
      let active = 0;
      let manuallyControlled = false;

      const stopCycling = () => {
        manuallyControlled = true;
        this.removeAttribute("data-cycling");
      };
      // CSS is the clock, so the border and tab advancement cannot drift apart.
      this.addEventListener(
        "animationend",
        (event) => {
          if (
            event.animationName !== "feature-countdown" ||
            !this.hasAttribute("data-cycling") ||
            document.hidden ||
            reducedMotion.matches ||
            manuallyControlled
          )
            return;
          active = (active + 1) % tabs.length;
          render();
        },
        { signal },
      );
      this.addEventListener("focusin", stopCycling, { signal });
      this.addEventListener("click", stopCycling, { signal });

      const updateMedia = () => {
        if (signal.aborted) return;
        this.toggleAttribute(
          "data-cycling",
          !manuallyControlled &&
            !reducedMotion.matches &&
            !document.hidden &&
            disclosures[active].open &&
            visible.has(stages[active]),
        );
        demos.forEach((demo, index) => {
          if (!demo) return;
          const selected = disclosures[index].open && index === active;
          // Reduced motion keeps the finished conversation on screen.
          demo.setPlaying?.(
            selected &&
              !reducedMotion.matches &&
              visible.has(stages[index]) &&
              !document.hidden,
          );
        });
      };

      const render = () => {
        tablist.hidden = false;
        this.setAttribute("data-tabs", "");
        disclosures.forEach((details, index) => {
          const selected = index === active;
          details.open = selected;
          tabs[index].setAttribute("aria-selected", String(selected));
          tabs[index].tabIndex = selected ? 0 : -1;
          panels[index].setAttribute("role", "tabpanel");
          panels[index].setAttribute("aria-labelledby", tabs[index].id);
          panels[index].tabIndex = 0;
        });
        // Scroll only the tab strip, never the page, when advancing a mobile tab.
        const strip = tablist.getBoundingClientRect();
        const selectedTab = tabs[active].getBoundingClientRect();
        if (selectedTab.left < strip.left)
          tablist.scrollLeft += selectedTab.left - strip.left;
        else if (selectedTab.right > strip.right)
          tablist.scrollLeft += selectedTab.right - strip.right;
        updateMedia();
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener(
          "click",
          () => {
            active = index;
            render();
          },
          { signal },
        );
        tab.addEventListener(
          "keydown",
          (event) => {
            let next = index;
            if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
            else if (event.key === "ArrowLeft")
              next = (index - 1 + tabs.length) % tabs.length;
            else if (event.key === "Home") next = 0;
            else if (event.key === "End") next = tabs.length - 1;
            else return;
            event.preventDefault();
            active = next;
            render();
            tabs[next].focus();
          },
          { signal },
        );
      });

      disclosures.forEach((details) =>
        details.addEventListener("toggle", updateMedia, { signal }),
      );
      const visibleObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && entry.intersectionRatio > 0)
              visible.add(entry.target);
            else visible.delete(entry.target);
          });
          updateMedia();
        },
        { threshold: [0, 0.01] },
      );
      stages.forEach((stage) => visibleObserver.observe(stage));
      document.addEventListener("visibilitychange", updateMedia, { signal });
      reducedMotion.addEventListener("change", updateMedia, { signal });
      // The demo element may upgrade after this one; sync once it can play.
      void customElements.whenDefined("demo-frame").then(updateMedia);
      render();
      this.cleanup = () => {
        controller.abort();
        visibleObserver.disconnect();
      };
    }

    disconnectedCallback() {
      this.cleanup?.();
      this.querySelectorAll<DemoFrame>("demo-frame").forEach((demo) =>
        demo.setPlaying?.(false),
      );
    }
  }

  if (!customElements.get("feature-tabs"))
    customElements.define("feature-tabs", FeatureTabs);
</script>

<style>
  [hidden] {
    display: none !important;
  }
  summary {
    position: relative;
    display: flex;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  details[open] .feature-chevron {
    transform: rotate(180deg);
  }
  .feature-tablist:not([hidden]) {
    display: flex;
    overflow-x: auto;
    overscroll-behavior-x: contain;
  }
  .feature-tab {
    flex-shrink: 0;
    white-space: nowrap;
  }
  @media (width < 48rem) {
    .feature-tab {
      flex: 1 0 auto;
      gap: 0.375rem;
      padding: 0.75rem 0.875rem;
    }
    .feature-tab > :global(svg) {
      width: 16px;
      height: 16px;
    }
  }
  [data-tabs] summary {
    display: none;
  }
  .feature-tab[aria-selected="true"] {
    background: white;
    border-bottom-color: transparent;
  }
  .feature-tab[aria-selected="true"] > span {
    color: var(--color-stone-900);
  }
  .feature-tab[aria-selected="true"]::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 2px;
    background: var(--color-primary);
  }
  @keyframes feature-countdown {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-cycling] .feature-tab[aria-selected="true"]::after {
      content: "";
      position: absolute;
      inset: auto 0 0;
      height: 2px;
      background: var(--color-primary);
      transform-origin: left;
      animation: feature-countdown var(--feature-duration, 10s) linear forwards;
    }
  }
  button:focus-visible,
  summary:focus-visible,
  .feature-panel:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: -3px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .feature-chevron {
      transition: transform 0.3s ease-in-out;
    }
    @supports (interpolate-size: allow-keywords) {
      details::details-content {
        interpolate-size: allow-keywords;
        block-size: 0;
        overflow: clip;
        transition:
          block-size 0.4s cubic-bezier(0.04, 0.62, 0.23, 0.98),
          content-visibility 0.4s allow-discrete;
      }
      details[open]::details-content {
        block-size: auto;
      }
    }
  }
</style>
