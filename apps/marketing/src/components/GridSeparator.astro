---
const patternId = `separator-${crypto.randomUUID()}`;
---

<div class="h-30 w-full overflow-hidden sm:h-max">
  <svg
    aria-hidden="true"
    xmlns="http://www.w3.org/2000/svg"
    width="1280"
    height="160"
    fill="none"
    viewBox="0 0 1280 160"
    ><path fill={`url(#${patternId})`} d="M0 0h1280v160H0z"></path><defs
      ><pattern
        id={patternId}
        width="1"
        height="1"
        patternTransform="matrix(27.72 0 0 29.12 626 46)"
        patternUnits="userSpaceOnUse"
        preserveAspectRatio="none"
        viewBox="0 0 27.72 29.12"
        ><g fill="var(--color-stone-200)"
          ><circle cx="7" cy="7" r="1"></circle><circle cx="7" cy="21" r="1"
          ></circle><circle cx="21" cy="7" r="1"></circle><circle
            cx="21"
            cy="21"
            r="1"></circle></g
        ></pattern
      ></defs
    ></svg
  >
</div>
