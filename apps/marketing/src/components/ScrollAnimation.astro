---
import { Image } from "astro:assets";
import { ScrollText } from "./ScrollText";
import sheriff from "@/assets/sheriff.jpg";
---

<div class="relative w-full">
  <div class="pointer-events-none absolute inset-0 opacity-50">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      xmlns:xlink="http://www.w3.org/1999/xlink"
      width="100%"
      height="100%"
      fill="none"
      class="h-full w-full"
    >
      <defs>
        <pattern
          id="scroll-grid-pattern"
          width="27.72"
          height="29.12"
          patternUnits="userSpaceOnUse"
          patternTransform="translate(626 46)"
        >
          <g fill="var(--color-stone-200)">
            <circle cx="7" cy="7" r="1"></circle>
            <circle cx="7" cy="21" r="1"></circle>
            <circle cx="21" cy="7" r="1"></circle>
            <circle cx="21" cy="21" r="1"></circle>
          </g>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#scroll-grid-pattern)"></rect>
    </svg>
  </div>
  <ScrollText client:load />
  <div class="sticky bottom-20 flex justify-center py-12">
    <div class="flex flex-col items-center gap-3">
      <Image
        src={sheriff}
        loading="lazy"
        alt="Sherif Adedokun"
        class="h-12 w-12 rounded-full border border-stone-200"
      />
      <div class="text-center">
        <p class="font-display text-xl font-medium text-stone-900">
          Sherif Adedokun
        </p>
        <p class="font-mono text-xs tracking-wider text-stone-500 uppercase">
          Founder at Pushbio Inc
        </p>
      </div>
    </div>
  </div>
</div>
