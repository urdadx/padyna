---
import { GlobeLinear, TextLinear } from "./icons";


---

<div class="card-animation-container bg-stone-0 group flex flex-1 flex-col">
  <div
    class="relative flex h-55 cursor-pointer items-center justify-center overflow-hidden bg-[#fafafa]"
  >
    <div class="relative flex h-40 w-100 items-center justify-center">
      <!-- Email API Card -->
      <div
        class="card card-left absolute z-1 flex h-31.5! w-30! flex-col gap-3 rounded-2xl border border-stone-200 bg-white p-4 pb-8 shadow-[0px_2px_4px_0px_rgba(0,0,0,0.05)] transition-all duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)]"
      >
        <div class="flex flex-col gap-2.5">
          <div class="text-stone-500">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              fill="none"
              viewBox="0 0 24 24"
            >
              <path
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                vector-effect="non-scaling-stroke"
                d="m16 10 1.227 1.057c.515.445.773.667.773.943s-.258.498-.773.943L16 14M8 10l-1.227 1.057C6.258 11.502 6 11.724 6 12s.258.498.773.943L8 14M13 9l-2 6"
              ></path>
              <path
                stroke="currentColor"
                stroke-width="1.5"
                vector-effect="non-scaling-stroke"
                d="M2.5 12c0-4.478 0-6.718 1.391-8.109S7.521 2.5 12 2.5c4.478 0 6.718 0 8.109 1.391S21.5 7.521 21.5 12c0 4.478 0 6.718-1.391 8.109S16.479 21.5 12 21.5c-4.478 0-6.718 0-8.109-1.391S2.5 16.479 2.5 12Z"
              ></path>
            </svg>
          </div>
          <span
            class="font-mono text-xs tracking-[0.48px] text-stone-500 uppercase"
          >
            FILES
          </span>
        </div>
        <div class="flex flex-col gap-3">
          <div class="h-px w-full rounded bg-stone-200"></div>
          <div class="h-px w-full rounded bg-stone-200"></div>
          <div class="h-px w-full rounded bg-stone-200"></div>
        </div>
      </div>

      <!-- SDK Card -->
      <div
        class="card card-center absolute z-3 flex h-31.5! w-30! flex-col gap-3 rounded-2xl border border-stone-200 bg-white p-4 pb-8 shadow-[0px_2px_4px_0px_rgba(0,0,0,0.05)] transition-all duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)]"
      >
        <div class="flex flex-col gap-2.5">
          <div class="text-stone-500">
            <GlobeLinear />
          </div>
          <span
            class="font-mono text-xs tracking-[0.48px] text-stone-500 uppercase"
          >
            WEBSITE
          </span>
        </div>
        <div class="flex flex-col gap-3">
          <div class="h-px w-full rounded bg-stone-200"></div>
          <div class="h-px w-full rounded bg-stone-200"></div>
          <div class="h-px w-full rounded bg-stone-200"></div>
        </div>
      </div>

      <!-- Skills Card -->
      <div
        class="card card-right absolute z-2 flex h-31.5! w-30! flex-col gap-3 rounded-2xl border border-stone-200 bg-white p-4 pb-8 shadow-[0px_2px_4px_0px_rgba(0,0,0,0.05)] transition-all duration-300 ease-[cubic-bezier(0.34,1.56,0.64,1)]"
      >
        <div class="flex flex-col gap-2.5">
          <div class="text-stone-500">
            <TextLinear />
          </div>
          <span
            class="font-mono text-xs tracking-[0.48px] text-stone-500 uppercase"
          >
            TEXTS
          </span>
        </div>
        <div class="flex flex-col gap-3">
          <div class="h-px w-full rounded bg-stone-200"></div>
          <div class="h-px w-full rounded bg-stone-200"></div>
          <div class="h-px w-full rounded bg-stone-200"></div>
        </div>
      </div>
    </div>
  </div>
  <div class="flex flex-col gap-2 border-t bg-white p-6">
    <p
      class="font-mono text-sm font-normal tracking-[0.56px] text-stone-800 uppercase"
    >
      Upload your business data
    </p>
    <p class="text-sm font-normal text-stone-500">
      Upload files, add links, or FAQs to provide the necessary context for
      answering customer queries.
    </p>
  </div>
</div>

<style>
  .card-left {
    transform: translateX(-95px) translateY(16px) rotate(-15deg);
  }
  .group:hover .card-left {
    transform: translateX(-130px) translateY(0px) rotate(-25deg);
  }

  .card-center {
    transform: translateX(0) translateY(0) scale(1);
  }
  .group:hover .card-center {
    transform: translateY(-20px) scale(1.15);
  }

  .card-right {
    transform: translateX(90px) translateY(16px) rotate(15deg);
  }
  .group:hover .card-right {
    transform: translateX(125px) translateY(0px) rotate(25deg);
  }
</style>
