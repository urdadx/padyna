---
import Slack from "@/assets/integrations/slack-1.png";
import Discord from "@/assets/integrations/discord.png";
import WhatsApp from "@/assets/integrations/whatsapp.png";
import Jira from "@/assets/integrations/jira.png";
import ClickUp from "@/assets/integrations/clickup.png";
import Calendly from "@/assets/integrations/calendly.png";
import Telegram from "@/assets/integrations/telegram.png";
import Cal from "@/assets/integrations/cal.avif";
import Notion from "@/assets/integrations/notion.png";
import GoogleDrive from "@/assets/integrations/google-drive.png";
import { Image } from "astro:assets";
const integrations = [
  {
    id: "slack",
    name: "Slack",
    logo: Slack,
    url: "https://docs.autosend.com/ai/integrations/slack",
  },
  {
    id: "discord",
    name: "Discord",
    logo: Discord,
    url: "https://docs.autosend.com/ai/integrations/discord",
  },
  {
    id: "whatsapp",
    name: "WhatsApp",
    logo: WhatsApp,
    url: "https://docs.autosend.com/ai/integrations/whatsapp",
  },
  {
    id: "notion",
    name: "Notion",
    logo: Notion,
    url: "https://docs.autosend.com/ai/integrations/notion",
  },
  {
    id: "google-drive",
    name: "Google Drive",
    logo: GoogleDrive,
    url: "https://docs.autosend.com/ai/integrations/google-drive",
  },
  {
    id: "telegram",
    name: "Telegram",
    logo: Telegram,
    url: "https://docs.autosend.com/ai/integrations/telegram",
  },
  {
    id: "jira",
    name: "Jira",
    logo: Jira,
    url: "https://docs.autosend.com/ai/integrations/jira",
  },
  {
    id: "clickup",
    name: "ClickUp",
    logo: ClickUp,
    url: "https://docs.autosend.com/ai/integrations/clickup",
  },
  {
    id: "calendly",
    name: "Calendly",
    logo: Calendly,
    url: "https://docs.autosend.com/ai/integrations/calendly",
  },
  {
    id: "cal",
    name: "Cal",
    logo: Cal,
    url: "https://docs.autosend.com/ai/integrations/calendar",
  },
];
---

<div
  id="integrations"
  class="grid w-full grid-cols-1 border-y border-stone-200 lg:grid-cols-2"
>
  <div
    class="flex flex-col justify-center gap-4 border-b border-stone-200 bg-white px-4 py-10 sm:px-6 md:px-10 md:py-16 lg:border-r lg:border-b-0 lg:px-16"
  >
    <p
      class="text-primary font-mono text-sm font-medium tracking-[0.56px] uppercase"
    >
      Integrations
    </p>
    <div class="flex flex-col gap-4">
      <h2
        class="max-w-100.5 text-[24px] leading-[1.2] font-medium sm:text-[32px]"
      >
        Works with your <br class="hidden sm:inline" />favorite tools.
      </h2>
      <p class="max-w-lg text-base leading-5.5 font-normal text-stone-500">
        Connect Padyna to the tools your team already uses. Bring conversations,
        knowledge, and workflows together to help customers wherever they reach
        you.
      </p>
      <a
        href="https://app.padyna.com"
        class="bg-primary mt-2 box-border flex h-8 w-fit cursor-pointer items-center justify-center gap-x-2 rounded-md px-4 py-1.5 text-center font-mono text-sm leading-5 font-semibold whitespace-nowrap text-white uppercase transition-all duration-75 ease-in select-none active:scale-95 active:shadow-none"
        translate="no"
      >
        Get started
      </a>
    </div>
  </div>
  <ul class="grid grid-cols-2">
    {
      integrations.map((integration) => (
        <li class="h-full border-b border-stone-200 odd:border-r nth-last-[-n+2]:border-b-0">
          <div class="group ease flex h-full justify-between gap-4 p-4 transition-colors duration-100 hover:bg-stone-100 md:p-6">
            <div class="flex flex-col justify-between gap-4">
              <Image
                src={integration.logo}
                alt=""
                width={24}
                height={24}
                widths={[24, 48]}
                sizes="24px"
                fit="contain"
                class="size-6 object-contain"
                loading="lazy"
              />
              <p class="font-mono text-sm font-medium text-stone-800 uppercase">
                {integration.name}
              </p>
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</div>
