---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap={name === "analytics" ? undefined : "round"}
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    paths[name].map((d) => (
      <path
        d={d}
        vector-effect={name === "analytics" ? undefined : "non-scaling-stroke"}
      />
    ))
  }
</svg>
