---

---

<div class="bg-stone-0 flex flex-1 flex-col">
  <div
    class="migration-tools-illustration relative flex h-55 cursor-pointer flex-col items-center justify-start overflow-hidden bg-[#fafafa] px-5.5 pt-8"
  >
    <div class="flex w-full justify-between gap-3">
      <div class="relative z-10 flex flex-col items-center gap-2.5">
        <div
          class="bg-stone-0 flex w-25 flex-col gap-2.5 rounded-2xl border border-stone-200 bg-white p-4 shadow-[0px_2px_4px_0px_rgba(0,0,0,0.05)] sm:w-30"
        >
          <div class="text-stone-500">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              ><path
                d="M12.8809 7.01656L17.6538 8.28825M11.8578 10.8134L14.2442 11.4492M11.9765 17.9664L12.9311 18.2208C15.631 18.9401 16.981 19.2998 18.0445 18.6893C19.108 18.0787 19.4698 16.7363 20.1932 14.0516L21.2163 10.2548C21.9398 7.57005 22.3015 6.22768 21.6875 5.17016C21.0735 4.11264 19.7235 3.75295 17.0235 3.03358L16.0689 2.77924C13.369 2.05986 12.019 1.70018 10.9555 2.31074C9.89196 2.9213 9.53023 4.26367 8.80678 6.94841L7.78366 10.7452C7.0602 13.4299 6.69848 14.7723 7.3125 15.8298C7.92652 16.8874 9.27651 17.2471 11.9765 17.9664Z"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                vector-effect="non-scaling-stroke"></path><path
                d="M12 20.9462L11.0477 21.2055C8.35403 21.939 7.00722 22.3057 5.94619 21.6832C4.88517 21.0607 4.52429 19.692 3.80253 16.9546L2.78182 13.0833C2.06006 10.3459 1.69918 8.97718 2.31177 7.89892C2.84167 6.96619 4 7.00015 5.5 7.00003"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                vector-effect="non-scaling-stroke"></path></svg
            >
          </div><span
            class="font-mono text-[10px] tracking-[0.48px] text-stone-500 uppercase sm:text-xs"
            >Templates</span
          >
        </div>
      </div><div class="relative z-10 flex flex-col items-center gap-2.5">
        <div
          class="bg-stone-0 flex w-25 flex-col gap-2.5 rounded-2xl border border-stone-200 bg-white p-4 shadow-[0px_2px_4px_0px_rgba(0,0,0,0.05)] sm:w-30"
        >
          <div class="text-stone-500">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              ><path
                d="M4.5 10C4.5 6.22876 4.5 4.34315 5.67157 3.17157C6.84315 2 8.72876 2 12.5 2H14C17.7712 2 19.6569 2 20.8284 3.17157C22 4.34315 22 6.22876 22 10V14C22 17.7712 22 19.6569 20.8284 20.8284C19.6569 22 17.7712 22 14 22H12.5C8.72876 22 6.84315 22 5.67157 20.8284C4.5 19.6569 4.5 17.7712 4.5 14V10Z"
                stroke="currentColor"
                stroke-width="1.5"
                vector-effect="non-scaling-stroke"></path><path
                d="M4.5 6H2M4.5 12H2M4.5 18H2"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                vector-effect="non-scaling-stroke"></path><path
                d="M15.2747 8.49261C15.2747 9.59715 14.3793 10.4926 13.2748 10.4926C12.1703 10.4926 11.2749 9.59715 11.2749 8.49261C11.2749 7.38808 12.1703 6.49268 13.2748 6.49268C14.3793 6.49268 15.2747 7.38808 15.2747 8.49261Z"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                vector-effect="non-scaling-stroke"></path><path
                d="M9.31982 15.7161C10.3782 14.0868 12.0589 13.4762 13.2749 13.4774C14.491 13.4787 16.1224 14.0868 17.1807 15.7161C17.2492 15.8215 17.268 15.9512 17.2063 16.0607C16.9588 16.4996 16.1903 17.3705 15.6352 17.4296C14.9975 17.4974 13.3291 17.5069 13.2762 17.5072C13.2232 17.5069 11.5034 17.4974 10.8653 17.4296C10.3103 17.3705 9.5418 16.4996 9.29429 16.0607C9.23254 15.9512 9.25139 15.8215 9.31982 15.7161Z"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                vector-effect="non-scaling-stroke"></path></svg
            >
          </div><span
            class="font-mono text-[10px] tracking-[0.48px] text-stone-500 uppercase sm:text-xs"
            >Contacts</span
          >
        </div>
      </div><div class="relative z-10 flex flex-col items-center gap-2.5">
        <div
          class="bg-stone-0 flex w-25 flex-col gap-2.5 rounded-2xl border border-stone-200 bg-white p-4 shadow-[0px_2px_4px_0px_rgba(0,0,0,0.05)] sm:w-30"
        >
          <div class="text-stone-500">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              ><path
                d="M6 8C7.10457 8 8 7.10457 8 6C8 4.89543 7.10457 4 6 4C4.89543 4 4 4.89543 4 6C4 7.10457 4.89543 8 6 8Z"
                stroke="currentColor"
                stroke-width="1.5"
                vector-effect="non-scaling-stroke"></path><path
                d="M12 20C13.1046 20 14 19.1046 14 18C14 16.8954 13.1046 16 12 16C10.8954 16 10 16.8954 10 18C10 19.1046 10.8954 20 12 20Z"
                stroke="currentColor"
                stroke-width="1.5"
                vector-effect="non-scaling-stroke"></path><path
                d="M18 8C19.1046 8 20 7.10457 20 6C20 4.89543 19.1046 4 18 4C16.8954 4 16 4.89543 16 6C16 7.10457 16.8954 8 18 8Z"
                stroke="currentColor"
                stroke-width="1.5"
                vector-effect="non-scaling-stroke"></path><path
                d="M6.01734 8.74067C6.01734 10.4142 5.77537 12.1995 9.22051 11.9855H12.0053M12.0053 11.9855H15.7861C16.9199 11.7648 18.1259 11.9855 17.9929 8.57617M12.0053 11.9855V15.7001"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                vector-effect="non-scaling-stroke"></path></svg
            >
          </div><span
            class="font-mono text-[10px] tracking-[0.48px] text-stone-500 uppercase sm:text-xs"
            >Automations</span
          >
        </div>
      </div>
    </div><div
      class="relative flex h-20 w-full items-center gap-0 overflow-hidden"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="100%"
        height="100%"
        viewBox="0 0 400 80"
        fill="none"
        class="absolute inset-0 h-full w-full"
        preserveAspectRatio="none"
      >
        <path
          id="path-templates"
          d="M60 0 C 60 40, 180 10, 200 60"
          stroke="#e5e7eb"
          stroke-width="1"
          fill="none"></path>
        <path
          id="path-contacts"
          d="M200 0 L 200 60"
          stroke="#e5e7eb"
          stroke-width="1"
          fill="none"></path>
        <path
          id="path-automations"
          d="M340 0 C 340 40, 220 10, 200 60"
          stroke="#e5e7eb"
          stroke-width="1"
          fill="none"></path>

        <!-- Animated Beams -->
        <circle r="2" fill="#8b5cf6" class="beam">
          <animateMotion
            dur="3s"
            repeatCount="indefinite"
            path="M60 0 C 60 40, 180 10, 200 60"></animateMotion>
        </circle>
        <circle r="2" fill="#8b5cf6" class="beam" style="animation-delay: 1s;">
          <animateMotion
            dur="3s"
            repeatCount="indefinite"
            path="M200 0 L 200 60"></animateMotion>
        </circle>
        <circle r="2" fill="#8b5cf6" class="beam" style="animation-delay: 2s;">
          <animateMotion
            dur="3s"
            repeatCount="indefinite"
            path="M340 0 C 340 40, 220 10, 200 60"></animateMotion>
        </circle>

        <!-- Glow effect for beams -->
        <circle r="4" fill="#8b5cf6" fill-opacity="0.2" class="beam">
          <animateMotion
            dur="3s"
            repeatCount="indefinite"
            path="M60 0 C 60 40, 180 10, 200 60"></animateMotion>
        </circle>
      </svg>
    </div><div class="relative z-10 -mt-10">
      <div
        class="autosend-icon-container flex h-16 w-16 items-center justify-center rounded-[19px] border border-stone-200 bg-white shadow-[2px_10px_20px_rgba(139,92,246,0.1)] transition-transform duration-300"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="40"
          height="40"
          viewBox="0 0 24 24"
          fill="none"
          class=""
          ><path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="m14 13-2-3-2 3"
            vector-effect="non-scaling-stroke"></path><path
            stroke="currentColor"
            stroke-linejoin="round"
            stroke-width="2"
            vector-effect="non-scaling-stroke"
            d="M14.5 5.5C14.5 8 12 10 12 10S9.5 8 9.5 5.5 10.62 2 12 2s2.5 1 2.5 3.5ZM18.5 15.5C16 15.5 14 13 14 13s2-2.5 4.5-2.5S22 11.62 22 13s-1 2.5-3.5 2.5ZM5.5 15.5C8 15.5 10 13 10 13s-2-2.5-4.5-2.5S2 11.62 2 13s1 2.5 3.5 2.5Z"
          ></path><path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M16 22s-3-6-6-9"
            vector-effect="non-scaling-stroke"></path><path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            vector-effect="non-scaling-stroke"
            d="M8 22s3-6 6-9"></path></svg
        >
      </div>
    </div>
  </div><div class="flex flex-col gap-2 border-t bg-white p-6">
    <p
      class="font-mono text-sm font-normal tracking-[0.56px] text-stone-800 uppercase"
    >
      Easy Migration Tools
    </p><p class="text-sm font-normal text-stone-500">
      Instantly Import your templates, contacts, and automations from Resend,
      SendGrid, Loops, and others.
    </p>
  </div>
</div>
<style>
  .migration-tools-illustration:hover .autosend-icon-container {
    transform: scale(1.1);
    box-shadow: 0 10px 25px -5px rgba(139, 92, 246, 0.2);
  }
</style>
