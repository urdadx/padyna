---
// Shows a dashboard snapshot page from `public/demos/` (see
// src/assets/features/README.md) in an iframe rendered at its captured size and
// scaled to this element's width; give this element the same aspect ratio.
// The page replays its conversation while playing: driven by `setPlaying()`,
// or, with `autoplay`, whenever it is on screen and motion is allowed.
interface Props {
  src: string;
  width: number;
  height: number;
  title: string;
  autoplay?: boolean;
  desktopOnly?: boolean;
  class?: string;
}

const {
  src,
  width,
  height,
  title,
  autoplay = false,
  desktopOnly = false,
  class: className,
} = Astro.props;
---

<demo-frame
  class:list={["relative block overflow-hidden", className]}
  data-width={width}
  data-autoplay={autoplay ? "" : undefined}
  data-desktop-only={desktopOnly ? "" : undefined}
>
  <iframe
    src={desktopOnly ? undefined : src}
    data-src={desktopOnly ? src : undefined}
    title={title}
    aria-hidden="true"
    tabindex="-1"
    loading={desktopOnly ? "eager" : "lazy"}
    class="pointer-events-none absolute top-0 left-0 origin-top-left border-0"
    style={`width: ${width}px; height: ${height}px`}></iframe>
</demo-frame>

<script>
  type DemoWindow = Window & {
    demo?: { setPlaying(playing: boolean): void };
  };

  class DemoFrame extends HTMLElement {
    private playing = false;
    private cleanup?: () => void;
    private desktopCleanup?: () => void;

    connectedCallback() {
      const iframe = this.querySelector("iframe")!;
      if (this.hasAttribute("data-desktop-only")) {
        const desktop = window.matchMedia("(min-width: 768px)");
        const loadOnDesktop = () => {
          if (desktop.matches && !iframe.hasAttribute("src"))
            iframe.src = iframe.dataset.src!;
        };
        desktop.addEventListener("change", loadOnDesktop);
        loadOnDesktop();
        this.desktopCleanup = () =>
          desktop.removeEventListener("change", loadOnDesktop);
      }
      const width = Number(this.dataset.width);
      const resizeObserver = new ResizeObserver(() => {
        iframe.style.transform = `scale(${this.clientWidth / width})`;
      });
      resizeObserver.observe(this);
      const sync = () => this.sync();
      iframe.addEventListener("load", sync);
      const cleanups = [
        () => resizeObserver.disconnect(),
        () => iframe.removeEventListener("load", sync),
      ];

      if (this.hasAttribute("data-autoplay")) {
        const reducedMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        );
        let visible = false;
        // Reduced motion keeps the finished conversation on screen.
        const update = () =>
          this.setPlaying(
            visible && !reducedMotion.matches && !document.hidden,
          );
        const visibilityObserver = new IntersectionObserver(([entry]) => {
          visible = entry.isIntersecting;
          update();
        });
        visibilityObserver.observe(this);
        reducedMotion.addEventListener("change", update);
        document.addEventListener("visibilitychange", update);
        cleanups.push(
          () => visibilityObserver.disconnect(),
          () => reducedMotion.removeEventListener("change", update),
          () => document.removeEventListener("visibilitychange", update),
        );
      }

      this.cleanup = () => cleanups.forEach((fn) => fn());
    }

    disconnectedCallback() {
      this.cleanup?.();
      this.desktopCleanup?.();
    }

    setPlaying(playing: boolean) {
      this.playing = playing;
      this.sync();
    }

    private sync() {
      const frame = this.querySelector("iframe")?.contentWindow as
        | DemoWindow
        | null
        | undefined;
      frame?.demo?.setPlaying(this.playing);
    }
  }

  if (!customElements.get("demo-frame"))
    customElements.define("demo-frame", DemoFrame);
</script>
