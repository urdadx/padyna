# Core application settings.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/padyna
BETTER_AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
POLAR_ACCESS_TOKEN=polar_access_token
POLAR_WEBHOOK_SECRET=polar_webhook_secret
POLAR_SUCCESS_URL=http://localhost:3001/billing/success
CORS_ORIGIN=http://localhost:3001
NODE_ENV=development

# Defaults are shown here explicitly for convenience.
SCRAPER_URL=https://scraper.padyna.com
POLAR_API_URL=https://sandbox-api.polar.sh/v1
REDIS_URL=redis://localhost:6379
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_BOT_USERNAME=padyna_bot

# Optional AI and email providers.
OPENAI_API_KEY=
RESEND_API_KEY=

# Optional Polar plan and add-on ids.
