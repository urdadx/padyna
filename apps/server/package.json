    "@padyna/db": "workspace:*",
    "@padyna/env": "workspace:*",
    "@trpc/server": "catalog:",
    "ai": "^6.0.100",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "hono": "catalog:",
    "mammoth": "^1.10.0",
    "nanoid": "^5.1.6",
    "pdf-parse": "^1.1.1",
    "uuid": "^13.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@padyna/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/uuid": "^11.0.0",
    "tsdown": "^0.16.5",
    "typescript": "catalog:"
  }
}
