{
  "name": "padyna-v2",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "check-types": "pnpm -r check-types",
    "dev:native": "pnpm --filter native dev",
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "db:push": "pnpm --filter @padyna-v2/db db:push",
    "db:studio": "pnpm --filter @padyna-v2/db db:studio",
    "db:generate": "pnpm --filter @padyna-v2/db db:generate",
    "db:migrate": "pnpm --filter @padyna-v2/db db:migrate",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "@padyna-v2/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@padyna-v2/config": "workspace:*",
    "@types/bun": "catalog:",
    "oxfmt": "^0.26.0",
    "oxlint": "^1.41.0",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.10.0"
}
